{
  "mcpServers": {
    "reliable-ai": {
      "command": "python",
      "args": ["-m", "reliable_ai.serve", "--features", "features.json", "--env-features", "environment_features.json"]
    },
    "code-search": {
      "type": "stdio",
      "command": "npx",
      "args": ["mcp-ripgrep@latest"]
    },
    "dreamteam-suggestions": {
      "command": "python",
      "args": ["-m", "dreamteam_suggestions_mcp"]
    },
    "dreamteam-lane-tracking": {
      "command": "python",
      "args": ["-m", "dreamteam_lane_tracking_mcp"]
    }
  }
}
